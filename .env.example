# OpsBot configuration
#
# The certificate bundle you download from the XDevOps portal
# (Settings -> Devices -> Install OpsBot -> Download certificate bundle)
# already contains a filled-in .env. Use this file only as a reference or
# if you need to recreate it by hand.
#
# OpsBot reads ".env" from the CURRENT WORKING DIRECTORY (the directory you
# start `opsbot` from), not from the directory the binary is installed in.
# Relative paths below are also resolved against that directory.
# Variables already set in your environment take precedence over this file.

# --- Connection -------------------------------------------------------------
# Your tenant's OpsBot endpoint. Replace <tenant-slug> with your tenant's slug.
WEBSOCKET_URI=wss://<tenant-slug>-shell.xdevops.ch/ws

# Your Microsoft Teams user id. The portal pre-fills this when your admin has
# linked your Teams account. Always set it.
WEBSOCKET_CLIENT_ID=<your-teams-user-id>

# --- TLS / mTLS -------------------------------------------------------------
# Keep "true". Only the exact value "false" disables server verification.
SSL_VERIFY=true

# Leave EMPTY. The XDevOps endpoint uses a public certificate that is verified
# against your operating system's trust store. Setting a CA file here REPLACES
# the system trust store and will break the connection.
SSL_CA_CERT=

# Client certificate and private key from the certificate bundle (mTLS).
# Keep the key private: chmod 600 opsbot.client.key
SSL_CLIENT_CERT=./opsbot.client.crt
SSL_CLIENT_KEY=./opsbot.client.key

# --- Logs -------------------------------------------------------------------
# Local, unredacted transcript of everything shown in the OpsBot shell.
LOGURU_LOG_FILE=./opsbot_audit.log
# Connection / TLS diagnostics. Check this first when the prompt shows "Offline".
DEBUG_LOG_FILE=./opsbot_debug.log

# --- Redaction (optional) ---------------------------------------------------
# Comma-separated Go regular expressions applied to terminal output before it
# is shared with the AI. Setting this REPLACES the built-in defaults.
# Patterns cannot contain a comma. Each match becomes "$1[REDACTED]", so put
# any text you want to keep (e.g. the key name) in capture group 1.
# REDACT_PATTERNS=(?i)(bearer\s+)[A-Za-z0-9._~+/=-]+,(?i)(api[_-]?key|password|secret|token)\s*[:=]\s*\S+
